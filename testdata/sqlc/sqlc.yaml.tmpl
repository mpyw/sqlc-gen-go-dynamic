version: "2"
plugins:
  - name: dynamic
    process:
      cmd: "@PLUGIN@"
      # The JSON encoding is what this plugin speaks, which is why it needs no protobuf
      # dependency.
      format: json
sql:
  - engine: postgresql
    schema: schema.sql
    queries: query.sql
    codegen:
      - plugin: dynamic
        out: gen
        options:
          package: gen
          sql_package: pgx/v5
          overrides:
            # timestamptz is nullable here, and pgtype has a type for exactly that. An
            # override decides the type outright, so nothing is added to it.
            - db_type: timestamptz
              nullable: true
              go_type: github.com/jackc/pgx/v5/pgtype.Timestamptz
